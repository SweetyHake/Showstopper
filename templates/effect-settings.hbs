{{#*inline "effectSettingField"}}
<div class="form-group" data-field-type="{{type}}">
  <label for="esf-{{effectId}}-{{name}}">{{label}}</label>

  {{#if (eq type "sound")}}
  <div class="form-fields sound-field">
    <input type="text" name="{{name}}" id="esf-{{effectId}}-{{name}}" value="{{value}}" placeholder="{{placeholder}}">
    <button type="button" class="icon-btn" data-action="browseSound" data-field="{{name}}" data-tooltip="{{labels.browse}}" aria-label="{{labels.browse}}">
      <i class="fa-solid fa-folder-open" aria-hidden="true"></i>
    </button>
    <button type="button" class="icon-btn" data-action="previewSound" data-field="{{name}}" data-tooltip="{{labels.previewSound}}" aria-label="{{labels.previewSound}}">
      <i class="fa-solid fa-play" aria-hidden="true"></i>
    </button>
  </div>
  {{else if (eq type "image")}}
  <div class="form-fields image-field">
    <input type="text" name="{{name}}" id="esf-{{effectId}}-{{name}}" value="{{value}}" placeholder="{{placeholder}}">
    <button type="button" class="icon-btn" data-action="browseImage" data-field="{{name}}" data-tooltip="{{labels.browse}}" aria-label="{{labels.browse}}">
      <i class="fa-solid fa-folder-open" aria-hidden="true"></i>
    </button>
  </div>
  {{else if (eq type "video")}}
  <div class="form-fields video-field">
    <input type="text" name="{{name}}" id="esf-{{effectId}}-{{name}}" value="{{value}}" placeholder="{{placeholder}}">
    <button type="button" class="icon-btn" data-action="browseVideo" data-field="{{name}}" data-tooltip="{{labels.browse}}" aria-label="{{labels.browse}}">
      <i class="fa-solid fa-film" aria-hidden="true"></i>
    </button>
  </div>
  {{else if (eq type "number")}}
  <div class="form-fields">
    <input type="number" name="{{name}}" id="esf-{{effectId}}-{{name}}" value="{{value}}"
           min="{{min}}" max="{{max}}" step="{{step}}" placeholder="{{placeholder}}">
    {{#if suffix}}<span class="field-suffix">{{suffix}}</span>{{/if}}
  </div>
  {{else if (eq type "range")}}
  <div class="form-fields range-field">
    <input type="range" name="{{name}}" id="esf-{{effectId}}-{{name}}" value="{{value}}"
           min="{{min}}" max="{{max}}" step="{{step}}">
    <output class="field-value" for="esf-{{effectId}}-{{name}}">{{value}}</output>
    {{#if suffix}}<span class="field-suffix">{{suffix}}</span>{{/if}}
  </div>
  {{else if (eq type "checkbox")}}
  <div class="form-fields">
    <input type="checkbox" name="{{name}}" id="esf-{{effectId}}-{{name}}" {{checked value}}>
  </div>
  {{else if (eq type "select")}}
  <div class="form-fields">
    <select name="{{name}}" id="esf-{{effectId}}-{{name}}">
      {{#each options}}
      <option value="{{value}}" {{#if (eq ../value value)}}selected{{/if}}>{{label}}</option>
      {{/each}}
    </select>
  </div>
  {{else if (eq type "color")}}
  <div class="form-fields color-field">
    <input type="color" name="{{name}}" id="esf-{{effectId}}-{{name}}" value="{{value}}">
    <input type="text" name="{{name}}_hex" value="{{value}}" class="color-hex" aria-label="{{label}}">
  </div>
  {{else if (eq type "textarea")}}
  <div class="form-fields textarea-field">
    <textarea name="{{name}}" id="esf-{{effectId}}-{{name}}" rows="{{rows}}" placeholder="{{placeholder}}">{{value}}</textarea>
  </div>
  {{else}}
  <div class="form-fields">
    <input type="text" name="{{name}}" id="esf-{{effectId}}-{{name}}" value="{{value}}" placeholder="{{placeholder}}">
  </div>
  {{/if}}
  {{#if hint}}
  <p class="field-hint">{{hint}}</p>
  {{/if}}
</div>
{{/inline}}

<form class="effect-settings-form" autocomplete="off">
  <header class="effect-settings-header">
    <div class="effect-icon"><i class="{{effectIcon}}" aria-hidden="true"></i></div>
    <h3>{{effectName}}</h3>
  </header>

  <p class="hint-text"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> {{labels.defaultHint}}</p>

  {{#if commonFields.length}}
  <fieldset class="settings-fieldset">
    <legend><i class="fa-solid fa-music" aria-hidden="true"></i> {{labels.common}}</legend>

    {{#each commonFields}}
      {{> effectSettingField this effectId=../effectId labels=../labels}}
    {{/each}}
  </fieldset>
  {{/if}}

  {{#if hasUniqueFields}}
  <fieldset class="settings-fieldset">
    <legend><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> {{labels.unique}}</legend>

    {{#each uniqueFields}}
      {{> effectSettingField this effectId=../effectId labels=../labels}}
    {{/each}}
  </fieldset>
  {{/if}}

  <footer class="form-footer">
    <button type="button" class="form-btn btn-secondary" data-action="reset">
      <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
      {{labels.reset}}
    </button>
    <button type="button" class="form-btn btn-primary" data-action="save">
      <i class="fa-solid fa-save" aria-hidden="true"></i>
      {{labels.save}}
    </button>
  </footer>
</form>
