<div class="effect-settings-form">
  <fieldset class="settings-fieldset">
    <legend>
      <i class="fas fa-eye" aria-hidden="true"></i>
      {{localize "showstopper.Vignette.OpacitySection"}}
    </legend>

    <div class="form-group">
      <label>{{localize "showstopper.Vignette.HealthLabel"}}</label>
      <div class="form-fields range-field sst-field-pair">
        <input type="range" name="opacity_health" value="{{opacity_health}}" min="0" max="1" step="0.05" />
        <input type="number" value="{{opacity_health}}" min="0" max="1" step="0.05" class="range-num sst-range-num" />
      </div>
      <p class="field-hint">{{localize "showstopper.Vignette.HealthHint"}}</p>
    </div>

    <div class="form-group">
      <label>{{localize "showstopper.Vignette.StatusLabel"}}</label>
      <div class="form-fields range-field sst-field-pair">
        <input type="range" name="opacity_status" value="{{opacity_status}}" min="0" max="1" step="0.05" />
        <input type="number" value="{{opacity_status}}" min="0" max="1" step="0.05" class="range-num sst-range-num" />
      </div>
      <p class="field-hint">{{localize "showstopper.Vignette.StatusHint"}}</p>
    </div>

    <div class="form-group">
      <label>{{localize "showstopper.Vignette.PopupLabel"}}</label>
      <div class="form-fields range-field sst-field-pair">
        <input type="range" name="opacity_popup" value="{{opacity_popup}}" min="0" max="1" step="0.05" />
        <input type="number" value="{{opacity_popup}}" min="0" max="1" step="0.05" class="range-num sst-range-num" />
      </div>
      <p class="field-hint">{{localize "showstopper.Vignette.PopupHint"}}</p>
    </div>
  </fieldset>

  <footer class="form-footer">
    <button type="submit" class="form-btn btn-primary">
      <i class="fas fa-save" aria-hidden="true"></i>
      {{localize "showstopper.Vignette.Save"}}
    </button>
  </footer>
</div>
