/**
 * Blood subsystem entry point (`esmodules` entry in `module.json`).
 *
 * Lifecycle: settings + "Snow Zone" RegionBehavior registration (`init`) → socket +
 * token config color field + engines (`ready`) → store + renderer hydrated from scene
 * flags (`canvasReady`) → flag reconciliation (`updateScene`). Damage/footprints/drips
 * are generated by the GM (`events.mjs`), weather/calendar snow by the GM (`snow.mjs`),
 * freehand painting by the GM (`brush.mjs`), and persistence uses debounced GM writes
 * to the scene flag.
 */

import { MODULE_ID } from '../config.mjs';
import { registerAPI } from '../core/runtime.mjs';
import { registerSocketHandler } from '../core/socket-manager.mjs';
import { BloodStore, readBloodFlag, STAIN, MATERIAL_MAX } from './stains.mjs';
import { BloodRenderer } from './renderer.mjs';
import { BloodAtlas } from './textures.mjs';
import { BloodEventHooks, SYSTEM_HP_PATHS, groundStainDefs } from './events.mjs';
import { getSnowAdapter, hasSnowAdapter, onSnowAdapter, meltSnowAt, blastSnowAt, freezeSnowAt, sweepDoorSnow, burySnowTracksAt } from './snow-bridge.mjs';
import { registerBloodZoneBehavior } from './zones.mjs';
import { registerBloodiedOverlay, teardownBloodied, syncBloodiedAll } from './bloodied.mjs';
import { clearCorpseImprints } from './corpse.mjs';
import { BloodBrush } from './brush.mjs';
import { BloodSettingsApp } from './settings-app.mjs';
import { wireBloodUndo, patchNativeUndo, resetBloodUndo, pushBloodOp, undoLastBloodOp } from './undo.mjs';
import { initBloodParticles, stopAllBursts, playBurst, debugStats as particleDebugStats } from './particles.mjs';
import { surfaceAt } from './elevation.mjs';
import { registerTokenColorField, tokenBloodColor } from './token-color.mjs';
import { sceneWeatherInfo } from './util.mjs';

const L = (key) => `${MODULE_ID}.blood.settings.${key}`;

let _store = null;
let _renderer = null;
let _brush = null;
let _events = null;
let _snow = null;
let _initDone = false;
let _readyDone = false;
let _snowBehaviorRegistered = false;

function _ensureSnowExtension(adapter = getSnowAdapter()) {
  if (!adapter) return;
  if (_initDone && !_snowBehaviorRegistered && typeof adapter.registerSnowRegionBehavior === 'function') {
    _snowBehaviorRegistered = true;
    adapter.registerSnowRegionBehavior();
  }
  if (_readyDone && !_snow && typeof adapter.SnowAccumulator === 'function') {
    _snow = new adapter.SnowAccumulator(() => _store);
    _snow.register();
  }
}

onSnowAdapter((adapter) => _ensureSnowExtension(adapter));

