/* --------------------------------- lifecycle --------------------------------- */

function _enabled() {
  try { return game.settings.get(MODULE_ID, 'bloodEnabled'); } catch { return true; }
}

/* --- Splatter conflict resolution: our blood stack supersedes Splatter (user
   decision 2026/11). If Splatter is active, mute it via ITS OWN world settings
   (GM-side, live): its `updateActor` checks `enableBloodsplatter` on every hit,
   and its `TokenBlood` rebuilds on `updateSetting` and hides its overlays. The
   client-side `hasExternalTokenBlood()` deference in `bloodied.mjs` remains as a
   fallback when a player connects before the GM. To revert: disable Showstopper's
   blood system (`bloodEnabled`), then re-enable Splatter manually. */

const _SPLATTER_GATES = ['enableBloodsplatter', 'enableTokenBlood', 'enableBloodTrail'];

function _retireSplatter() {
  try {
    if (!game.user?.isGM || !_enabled()) return;
    if (!game.modules?.get('splatter')?.active) return;
    const off = [];
    for (const key of _SPLATTER_GATES) {
      if (game.settings.get('splatter', key) === false) continue;
      game.settings.set('splatter', key, false);
      off.push(key);
    }
    const tb = game.settings.get('splatter', 'tokenBlood');
    if (tb && tb.enabled !== false) {
      game.settings.set('splatter', 'tokenBlood', { ...tb, enabled: false });
      off.push('tokenBlood.enabled');
    }
    if (off.length) ui?.notifications?.info(game.i18n.localize(`${MODULE_ID}.blood.splatterConflict`));
  } catch { /* splatter missing some keys — not our concern */ }
}

function _teardown() {
  try { _brush?.exit(); } catch { /* noop */ }
  try { _renderer?.destroy(); } catch { /* noop */ }
  _renderer = null;
  try { _store?.destroy(); } catch { /* noop */ }
  _store = null;
  resetBloodUndo(); // stain IDs are per-scene: undo stack does not survive scene switches
}

function _boot() {
  if (!_enabled() || !canvas?.scene) return;
  try { BloodAtlas.ensure(); } catch (e) { console.warn(`${MODULE_ID} | blood atlas build failed`, e); }

  _store = new BloodStore(canvas.scene);
  _store.load();
  try {
    const scale = Number(game.settings.get(MODULE_ID, 'bloodRenderScale')) || 0.5;
    _renderer = new BloodRenderer({ scale });
  } catch (e) {
    // Do not keep the store alive silently without a renderer: it would sync invisible blood
    console.warn(`${MODULE_ID} | blood renderer boot failed`, e);
    _store = null;
    return;
  }
  _store.setRenderer(_renderer);
  _renderer.rebuildFrom(_store.stains);
  _brush = _brush ?? new BloodBrush(() => _store, () => _renderer);
  wireBloodUndo(() => ({ store: _store, renderer: _renderer }));
}

function _onEnabledChange() {
  if (_enabled()) {
    if (!_renderer) _boot();
  } else {
    _teardown();
  }
}

function _rebuildRenderer() {
  if (!_store) return;
  try { _renderer?.destroy(); } catch { /* noop */ }
  const scale = Number(game.settings.get(MODULE_ID, 'bloodRenderScale')) || 0.5;
  _renderer = new BloodRenderer({ scale });
  _store.setRenderer(_renderer);
  _renderer.rebuildFrom(_store.stains);
}

function _onCanvasReady() {
  // Pending stroke commits and old scene drawings die with the previous canvas
  try { _brush?.exit({ restoreTool: false }); } catch { /* noop */ }
  try { _renderer?.destroy(); } catch { /* noop */ }
  _renderer = null;
  try { _store?.destroy(); } catch { /* noop */ }
  _store = null;
  resetBloodUndo(); // stain IDs are per-scene
  _boot();
}

function _onUpdateScene(scene, changes) {
  if (!_store || !canvas?.scene || scene.id !== canvas.scene.id) return;
  // The GM is the sole writer of the scene flag: their store is authoritative, and this
  // `updateScene` is an echo of THEIR OWN write. Reconciling destructively against one's
  // own echo wiped stains painted between flush and write delivery (~50-300 ms window).
  if (game.user.isGM) return;
  const diff = changes?.flags?.[MODULE_ID];
  // Bucketed `blood` diffs are partial (`b3`, `nextId`, …) — reconcile against the FULL
  // assembled scene flag state rather than the partial diff
  if (!diff || !Object.prototype.hasOwnProperty.call(diff, 'blood')) return;
  const data = readBloodFlag(canvas.scene);
  _store.reconcile(data ?? { stains: [], nextId: 1 });
}

/* ------------------------------- scene controls ------------------------------- */

function _registerControls() {
  Hooks.on('getSceneControlButtons', (controls) => {
    if (!game.user.isGM || !_enabled()) return;

    // The brush is a selectable tool in the DRAWINGS GROUP (`controls.drawings`):
    // it is a freehand drawing tool, not token management. In v14, `onChange` receives
    // `(event, active)`; `active=false` fires on the OUTGOING tool when switching —
    // our native signal to exit brush mode. Eraser and clear live inside the brush HUD
    // rather than as separate tools. Pointer capture runs in the document capture phase,
    // preventing native `drawings` layer creation from starting underneath the active brush.
    const drawTools = controls.drawings?.tools;
    if (drawTools) {
      drawTools['blood-brush'] = {
        name: 'blood-brush',
        title: game.i18n.localize(`${MODULE_ID}.blood.tools.brush`),
        icon: 'fa-solid fa-brush',
        visible: true,
        order: 9999,
        onChange: (event, active) => {
          if (active) _brush?.enter('paint');
          else _brush?.exit({ restoreTool: false });
        }
      };
    }

    const tools = controls.tokens?.tools;
    if (!tools) return;
    // Splat on selected tokens stays in token controls since its targets are tokens
    tools['blood-splat'] = {
      name: 'blood-splat',
      title: game.i18n.localize(`${MODULE_ID}.blood.tools.splat`),
      icon: 'fa-solid fa-droplet',
      visible: true,
      button: true,
      onChange: () => {
        const selected = [...(canvas.tokens?.controlled ?? [])];
        if (!selected.length) {
          ui.notifications.warn(game.i18n.localize(`${MODULE_ID}.blood.tools.splatWarn`));
          return;
        }
        for (const t of selected) _events?.splat(t, { impact: 0.5 });
      }
    };
  });
}

/* ----------------------------------- API ----------------------------------- */

/** Remove only snow cover from the active scene (snow material stains, excluding footprints). */
function _clearSnow() {
  if (!_gmGate()) return 0; // warn-once: docs promise diagnosable gating across all mutating API methods
  if (!_store) return 0;
  const ids = _store.stains.filter(s => s.m === 2 && s.t !== STAIN.FOOTPRINT).map(s => s.i);
  if (ids.length) _store.remove(ids);
  return ids.length;
}

/** Full clear: push stains onto the undo stack + remove corpse imprints (GM).
 *  Routes through the brush (if active) so undo stack and HUD update in one place. */
async function _clearAll() {
  if (!game.user.isGM || !_store) return;
  if (_brush?.active) {
    _brush.clearAllSilent();
  } else if (_store.count) {
    pushBloodOp('remove', [..._store.stains]);
    _store.clear();
  }
  try { await clearCorpseImprints(); } catch { /* imprints are non-critical */ }
}

// Diagnosable GM API gate: warn once instead of a silent no-op so macro authors
// do not have to debug blind
const _warnedApiGates = new Set();
function _gmGate() {
  if (game.user.isGM) return true;
  if (!_warnedApiGates.has('api')) {
    _warnedApiGates.add('api');
    try { ui.notifications.warn(game.i18n.localize(`${MODULE_ID}.blood.api.gmOnly`)); } catch { /* noop */ }
  }
  return false;
}

function _buildAPI() {
  return {
    version: 2,

    /** Capabilities of the current build (discoverability without magic numbers):
     *  future materials/types can be probed via `caps` rather than silently clamped. */
    caps: { types: 8, materials: 2, flagVersion: 2 },

    /** Stain record constants (for macros instead of raw 0..7). */
    STAIN: Object.freeze({ ...STAIN }),
    MATERIALS: Object.freeze({ blood: 0, snow: 2 }),

    isEnabled: () => _enabled(),

    /** Manual splatter on a token (GM-side: generation + broadcast). */
    splat: (token, opts) => _events?.splat(token, opts),

    /** Add stains declaratively (GM only): `[{t,x,y,s,r,a,c,seed?,d?,f?,g?,m?,e?,tid?,w?,T?}]`.
     *  `m` is material (see `MATERIALS`); without `e`/`w` blood lands on the floor and ignores
     *  walls — use `groundStainDefs` to ground them first. `T` is creation `worldTime`
     *  (aging/drying). Returns the actually added records. */
    addStains: (defs) => {
      if (!game.user.isGM) { _gmGate(); return []; } // world data: non-GM calls would create local phantoms
      if (!_store || !Array.isArray(defs)) return [];
      return _store.add(defs.map(d => _store.createStain(d)));
    },

    /** Remove stains by ID (GM only). Returns the array of ACTUALLY removed IDs
     *  (symmetric with `addStains` so macros can verify what existed). */
    removeStains: (ids) => {
      if (!game.user.isGM) { _gmGate(); return []; }
      return _store?.remove(ids) ?? [];
    },

    /** Decorate stain defs with surface elevation/tile and wall profile (`e`/`tid`/`w`) —
     *  call BEFORE `addStains`, otherwise blood lands on the floor and bleeds through walls. */
    groundStainDefs: (defs, upTo) => groundStainDefs(defs, upTo),

    clear: () => {
      if (!game.user.isGM) { _gmGate(); return; }
      _clearAll();
    },

    /** Immediately persist the scene flag (`await` macro workflows: "splat and export").
     *  Returns the write-chain promise. */
    flush: () => _store?.flush() ?? Promise.resolve(),

    /** Undo the top blood operation (brush / API mutations / auto-generated GM stains). */
    undo: () => undoLastBloodOp(),

    /** Cosmetic spray burst on all clients (GM), matching impact bursts. */
    burst: (payload = {}) => {
      if (!game.user.isGM) { _gmGate(); return; }
      playBurst({ ...payload, sceneId: _store?.sceneId });
    },

    /** Clear only snow from the scene (GM): returns the number of removed stains. */
    clearSnow: () => _clearSnow(),

    stats: () => ({
      stains: _store?.count ?? 0,
      chunks: _renderer?.stats.chunks ?? 0,
      scale: _renderer?.stats.scale ?? 0,
      overlays: _renderer?.stats.overlays ?? 0
    }),

    /** Query stains within a circle (store spatial index): `[{...record}]` or `[]`. */
    getStainsAt: (x, y, r = 20) => {
      if (!_store) return [];
      return _store.queryCircle(Number(x) || 0, Number(y) || 0, Math.max(1, Number(r) || 1))
        .map(s => ({ ...s }));
    },

    brush: {
      enter: (mode) => _brush?.enter(mode ?? 'paint'),
      exit: () => _brush?.exit(),
      toggle: (mode) => _brush?.toggle(mode ?? 'paint'),
      pickAt: (x, y) => _brush?.pickAt(Number(x) || 0, Number(y) || 0) ?? null,
      clearMaterial: (material) => _brush?.clearMaterialSilent(material) ?? 0,
      get active() { return _brush?.active ?? false; },
      get mode() { return _brush?.mode ?? null; }
    },

    /** Resolve a token's blood color (token flag → Bloodsheet → world default). */
    tokenColor: tokenBloodColor,

    /** Open the blood subsystem settings window (GM). */
    openSettings: () => BloodSettingsApp.show(),

    /** Snow engine (`showstopper-plus`): accumulation state and interactive operations (GM). */
    snow: {
      get available() { return hasSnowAdapter(); },
      stats: () => _snow?.stats() ?? null,
      clear: () => _clearSnow(),
      meltAt: (x, y, radius = 120, intensity = 1, opts = {}) => _store ? meltSnowAt(_store, x, y, radius, intensity, opts) : 0,
      blastAt: (x, y, radius = 120, intensity = 1, dir = null, elev = 0, opts = {}) => _store ? blastSnowAt(_store, x, y, radius, intensity, dir, elev, opts) : 0,
      freezeAt: (x, y, radius = 100, elev = 0) => _store ? freezeSnowAt(_store, x, y, radius, elev) : null,
      buryTracksAt: (x, y, radius = 120, surface = null, strength = 1, opts = {}) => _store ? burySnowTracksAt(_store, x, y, radius, surface, strength, opts) : 0,
      sweepDoor: (wallDoc, changes = { ds: 1 }, opts = {}) => _store ? sweepDoorSnow(_store, wallDoc, changes, opts) : { cleared: 0, piled: 0, type: null }
    },

    internal: {
      get store() { return _store; },
      get renderer() { return _renderer; },
      /** Particle pool counters (`{active, capacity, free, quality, frames, containers}`). */
      particles: particleDebugStats,
      /** Pixel-level surface hit test: `{e, tid, lvl}` — console helper for debugging elevations. */
      surfaceAt: (x, y, upTo = Number.POSITIVE_INFINITY, levelOrId = null) => surfaceAt(Number(x) || 0, Number(y) || 0, Number(upTo), levelOrId)
    }
  };
}

/* ----------------------------------- hooks ----------------------------------- */

Hooks.once('init', () => {
  _initDone = true;
  _registerSettings();
  _ensureSnowExtension();
  registerBloodZoneBehavior();
});

/**
 * Rain washout anchor: while the scene weather is rain/storm, the GM maintains
 * `bloodRain.t` (`worldTime` when the downpour started) — the renderer computes
 * blood washout contrast from it. Once weather clears, the anchor is unset. Weather
 * changes repaint live chunks so washed blood does not stay faded after rain stops
 * (washout is a non-destructive render multiplier).
 */
let _lastAgeRefreshWt = null;

function _refreshAgeVisuals({ agingOnly = false } = {}) {
  try {
    if (agingOnly && typeof _renderer?.refreshAging === 'function') {
      _renderer.refreshAging();
    } else {
      _renderer?.refreshAll();
    }
  } catch { /* noop */ }
}

function _syncRainFlag() {
  if (!game.user?.isGM || !_enabled() || !canvas?.scene) return;
  const rainy = sceneWeatherInfo(canvas.scene).rain;
  const cur = canvas.scene.getFlag(MODULE_ID, 'bloodRain')?.t;
  try {
    if (rainy && cur == null && (game.settings.get(MODULE_ID, 'bloodRainWash') ?? true)) {
      canvas.scene.setFlag(MODULE_ID, 'bloodRain', { t: Number(game.time?.worldTime) || 0 }).catch(() => { /* player/failure — skip washout */ });
    } else if (!rainy && cur != null) {
      canvas.scene.unsetFlag(MODULE_ID, 'bloodRain').catch(() => { /* noop */ });
    }
  } catch { /* noop */ }
  _refreshAgeVisuals({ agingOnly: true }); // weather changed — recompute blood contrast (leave pure snow chunks untouched)
}

Hooks.on('updateScene', (scene, changes) => {
  if (!game.user.isGM || !_enabled()) return;
  if (!canvas?.scene || scene.id !== canvas.scene.id) return;
  if (!(changes && 'weather' in changes)) return;
  _syncRainFlag();
});

Hooks.on('calendaria.weatherChange', () => _syncRainFlag());
Hooks.on('calendaria.weatherPeriodChange', () => _syncRainFlag());

// Aging/washout only become visible when blood-bearing chunks repaint: tick once per
// in-game hour (pure snow chunks are NEVER rebaked when advancing world time!)
Hooks.on('updateWorldTime', () => {
  if (!_renderer || !_store?.count) return;
  let wet = false;
  try { wet = sceneWeatherInfo(canvas.scene).rain && (game.settings.get(MODULE_ID, 'bloodRainWash') ?? true); } catch { /* noop */ }
  let aging = false;
  try { aging = (game.settings.get(MODULE_ID, 'bloodAging') ?? true) && ((Number(game.settings.get(MODULE_ID, 'bloodDryHours')) || 0) > 0); } catch { /* noop */ }
  if (!wet && !aging) return;
  const wt = Math.floor((Number(game.time?.worldTime) || 0) / 3600);
  if (wt === _lastAgeRefreshWt) return;
  _lastAgeRefreshWt = wt;
  _refreshAgeVisuals({ agingOnly: true });
});

// Closing the tab within the 3s persistence debounce window used to lose unpersisted ops:
// players saw blood live, but it vanished on reload. Best-effort flush on `beforeunload`
// (socket.io flushes its buffer in time) + on `visibilitychange` (mobile/tab sleep kills
// timers just as reliably)
Hooks.once('ready', () => {
  window.addEventListener('beforeunload', () => { try { _store?.destroy(); } catch { /* noop */ } });
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden') { try { _store?.flush(); } catch { /* noop */ } }
  });
});

// Replace `bloodOpener` text input with a button that opens the blood settings dialog (`docsOpener` pattern)
Hooks.on('renderSettingsConfig', (app, html) => {
  const el = html instanceof HTMLElement ? html : html?.[0];
  if (!el) return;
  const section = el.querySelector(`.tab[data-tab="${MODULE_ID}"]`)
    ?? el.querySelector(`[data-category="${MODULE_ID}"]`);
  if (!section) return;
  const group = section.querySelector('[name="showstopper.bloodOpener"]')?.closest('.form-group');
  if (!group || group.dataset.ssBloodOpener === '1') return;
  group.dataset.ssBloodOpener = '1';
  group.innerHTML = '';

  const label = document.createElement('label');
  label.textContent = game.i18n.localize(`${MODULE_ID}.blood.settings.menuName`);

  const fields = document.createElement('div');
  fields.className = 'form-fields';
  const btn = document.createElement('button');
  btn.type = 'button';
  btn.innerHTML = `<i class="fas fa-droplet"></i> ${game.i18n.localize(`${MODULE_ID}.blood.settings.menuButton`)}`;
  btn.addEventListener('click', (e) => {
    e.preventDefault();
    BloodSettingsApp.show();
  });
  fields.appendChild(btn);
  group.append(label, fields);

  const hint = document.createElement('p');
  hint.className = 'hint';
  hint.textContent = game.i18n.localize(`${MODULE_ID}.blood.settings.menuHint`);
  group.appendChild(hint);
});

Hooks.once('ready', () => {
  // Only a GM source may broadcast blood ops to clients: `game.socket` does not
  // attribute senders, so the writer must attach `from` and recipients must verify
  // GM role. Strict gate: ops WITHOUT `from` are also dropped, otherwise any client
  // could paint/erase blood for everyone simply by omitting the field.
  registerSocketHandler('blood:apply', (data) => {
    if (!data || typeof data !== 'object') return;
    if (!data.from || data.from === game.user?.id || !game.users.get(data.from)?.isGM) return;
    if (_store && (!data.sceneId || data.sceneId === _store.sceneId)) _store.applyRemote(data);
  });
  initBloodParticles();

  _readyDone = true;
  _events = new BloodEventHooks(() => _store, () => _renderer);
  _events.register();
  _ensureSnowExtension();
  if (!_brush) _brush = new BloodBrush(() => _store, () => _renderer);
  patchNativeUndo(); // empty native CTRL+Z falls back to undoing the last brush stroke

  registerTokenColorField();
  registerBloodiedOverlay();
  _retireSplatter(); // our blood stack supersedes Splatter — disable its settings
  registerAPI('blood', _buildAPI());
});

// Register control buttons at module load (same as `main.mjs`), not on `ready` —
// guarantees the control palette receives the hook regardless of load order
_registerControls();

Hooks.on('canvasReady', _onCanvasReady);
Hooks.on('canvasTearDown', () => {
  // Containers die with the canvas; flush unpersisted stains to the outgoing scene's flag
  try { _brush?.exit({ restoreTool: false }); } catch { /* noop */ }
  stopAllBursts();
  teardownBloodied(); // "bloodied" overlays are children of the outgoing scene's token meshes
  try { _events?.dispose(); } catch { /* noop */ }
  try { _store?.destroy(); } catch { /* noop */ }
  _store = null;
  // The renderer MUST be explicitly destroyed: without `destroy()`, its deferred/fading
  // clock stays attached to the persistent `canvas.app.ticker`, ticking fades into nowhere
  // and flushing orphaned textures
  try { _renderer?.destroy(); } catch { /* noop */ }
  _renderer = null;
});
Hooks.on('updateScene', _onUpdateScene);

function _rebuildOnLevelChange(levelDoc) {
  if (!_renderer || !_store || !canvas?.scene) return;
  if (levelDoc?.parent?.id && levelDoc.parent.id !== canvas.scene.id) return;
  _renderer.rebuildFrom(_store.stains);
}
Hooks.on('updateLevel', _rebuildOnLevelChange);
Hooks.on('deleteLevel', _rebuildOnLevelChange);
